# Optional server-side NewsAPI adapter. Never expose this value to browser code.
NEWS_API_KEY=

# Comma-separated administrators allowed to change/fetch shared news.
NEWS_ADMIN_EMAILS=for.administ@gmail.com

# Optional RSS/Atom source overrides. These are server-side defaults.
NEWS_FEED_JAPAN_URL=
NEWS_FEED_WORLD_URL=
NEWS_FEED_STOCKS_URL=

# Existing Firebase Admin credentials used by Vercel Functions and scheduled jobs.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GitHub Actions uses the existing service-account JSON as one repository secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
