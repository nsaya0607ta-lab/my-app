{
  "name": "pdf-folder-manager",
  "private": true,
  "version": "1.0.0",
  "description": "スマートフォン向け PDF フォルダー管理アプリ (PWA)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:cloud": "node scripts/test-cloud-storage.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
